<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Left column: status + readout + connect -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connect"
            android:layout_marginBottom="4dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/sectionDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <org.caniorebirth.android.GaugeView
                            android:id="@+id/gaugeSoc"
                            android:layout_width="0dp"
                            android:layout_height="120dp"
                            android:layout_weight="1" />

                        <org.caniorebirth.android.GaugeView
                            android:id="@+id/gaugeRpm"
                            android:layout_width="0dp"
                            android:layout_height="120dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <org.caniorebirth.android.GaugeView
                            android:id="@+id/gaugePower"
                            android:layout_width="0dp"
                            android:layout_height="120dp"
                            android:layout_weight="1" />

                        <org.caniorebirth.android.GaugeView
                            android:id="@+id/gaugeCurrent"
                            android:layout_width="0dp"
                            android:layout_height="120dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <org.caniorebirth.android.GaugeView
                            android:id="@+id/gaugeAux"
                            android:layout_width="0dp"
                            android:layout_height="120dp"
                            android:layout_weight="1" />

                        <org.caniorebirth.android.GaugeView
                            android:id="@+id/gaugeAcPower"
                            android:layout_width="0dp"
                            android:layout_height="120dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/tvGear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="P"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="#00E676"
                            android:layout_marginEnd="16dp" />

                        <TextView
                            android:id="@+id/tvRange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- km"
                            android:textSize="18sp"
                            android:textColor="#00E676" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCellSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cells: --"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvReadout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/tvErrors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No errors"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                    <org.caniorebirth.android.SignalChartView
                        android:id="@+id/chartSoc"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginTop="4dp" />

                    <org.caniorebirth.android.SignalChartView
                        android:id="@+id/chartVolt"
                        android:layout_width="match_parent"
                        android:layout_height="100dp" />

                    <org.caniorebirth.android.SignalChartView
                        android:id="@+id/chartCurr"
                        android:layout_width="match_parent"
                        android:layout_height="100dp" />

                    <org.caniorebirth.android.SignalChartView
                        android:id="@+id/chartCellSpread"
                        android:layout_width="match_parent"
                        android:layout_height="100dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionCells"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <org.caniorebirth.android.CellGridView
                        android:id="@+id/cellGrid"
                        android:layout_width="match_parent"
                        android:layout_height="200dp" />

                    <org.caniorebirth.android.CellGridView
                        android:id="@+id/cellTempGrid"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionHeater"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvHeater"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionVehicle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvVehicle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionMap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <fragment
                        android:id="@+id/map"
                        android:name="org.caniorebirth.android.MapFragment"
                        android:layout_width="match_parent"
                        android:layout_height="300dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Right column: could hold extra info; keep empty for now -->
</LinearLayout>
