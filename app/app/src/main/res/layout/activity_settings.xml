<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Units"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/swFahrenheit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Temperatures in Fahrenheit" />

        <Switch
            android:id="@+id/swKilometers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Distance in kilometers" />

        <Switch
            android:id="@+id/swDarkMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dark mode (auto if off)" />
        <Switch
            android:id="@+id/swFullScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Full screen (hide status bar)" />

        <Switch
            android:id="@+id/swVeilidEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable Veilid telemetry" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Veilid is a peer-to-peer network. When enabled, the app publishes SOC, voltage, current, RPM, gear and errors to a DHT record readable from anywhere, without opening ports. Disable to keep all data local."
            android:textSize="12sp"
            android:padding="8dp" />

        <Switch
            android:id="@+id/swForceLandscape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Force landscape orientation" />

        <Switch
            android:id="@+id/swVeilSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send telemetry to Veil service" />

        <Switch
            android:id="@+id/swFileLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log to file (/sdcard/BT_CAN)" />

        <Button
            android:id="@+id/btnForgetDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Forget saved BT device"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Advanced"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etOdometerDivisor"
            android:hint="Odometer divisor (default 57.75)"
            android:inputType="numberDecimal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <EditText
            android:id="@+id/etLogDir"
            android:hint="Crash log directory (default app files)"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <EditText
            android:id="@+id/etVeilidRecordKey"
            android:hint="Veilid DHT record key (leave empty to auto-create)"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Switch
            android:id="@+id/sw96Cell"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Force 96-cell pack" />

        <Button
            android:id="@+id/btnVeilidTest"
            android:text="Test Veilid Init"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
        <Button
            android:id="@+id/btnOpenLogDir"
            android:text="Open log folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnSave"
            android:text="Save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />
    </LinearLayout>
</ScrollView>
