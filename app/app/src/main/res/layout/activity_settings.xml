<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Veil Service"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etVeilHost"
            android:hint="Veil host (e.g. 192.168.1.42)"
            android:inputType="textUri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etVeilPort"
            android:hint="Veil port (default 8080)"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etVehicleId"
            android:hint="VEHICLE_001"
            android:inputType="text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Units"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/swFahrenheit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Temperatures in Fahrenheit" />

        <Switch
            android:id="@+id/swKilometers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Distance in kilometers" />

        <Switch
            android:id="@+id/swDarkMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dark mode (auto if off)" />

        <Switch
            android:id="@+id/swForceLandscape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Force landscape orientation" />

        <Switch
            android:id="@+id/swVeilSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send telemetry to Veil service" />

        <Switch
            android:id="@+id/swFileLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log to file (/sdcard/BT_CAN)" />

        <Button
            android:id="@+id/btnForgetDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Forget saved BT device"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Advanced"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etOdometerDivisor"
            android:hint="Odometer divisor (default 57.75)"
            android:inputType="numberDecimal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <EditText
            android:id="@+id/etLogDir"
            android:hint="Crash log directory (default app files)"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Switch
            android:id="@+id/sw96Cell"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Force 96-cell pack" />

        <Button
            android:id="@+id/btnVeilidTest"
            android:text="Test Veilid Init"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnSave"
            android:text="Save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />
    </LinearLayout>
</ScrollView>
