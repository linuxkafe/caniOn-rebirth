# ---------------------------------------------------------------------------
# caniOn Rebirth — ignore rules
# ---------------------------------------------------------------------------

# The original caniOn APK and every patched build. These are not part of the
# source: the original is proprietary and the builds are artefacts.
*.apk
*.aab
*.dex
*.jar
*.keystore
*.jks
*.p12

# The internal AES project (tickets, shadow docs, analysis). Local only —
# it is a working notebook, not part of the published project.
aes/

# Local build output
build/
.gradle/
local.properties

# Tooling fetched by the scripts
tools/kotlinc/
tools/build-tools/
tools/bt/

# Decompiled reference material (produced by tools/Dex2Java.java).
# Kept out of the repository: it is derived from a proprietary binary.
reference/

# Locally installed Android build-tools (apksigner, zipalign, aapt2)
.tools/

# The emulator is told to install the app; the debug directory lives on the
# device, not here.
